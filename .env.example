# NATIUM Entry — environment variables
# Copy to .env.local for local development. Never commit .env.local.
# Only VITE_* variables are exposed to the browser. NEVER put the service_role key here.

# Supabase project URL (local: http://127.0.0.1:54321)
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Supabase anon/publishable key (safe for the browser; RLS protects data)
VITE_SUPABASE_ANON_KEY=

# White-label identity (see src/config/brand.ts)
VITE_BRAND_NAME=NATIUM
VITE_BRAND_PRODUCT=NATIUM Entry
VITE_BRAND_TAGLINE=Cada segundo cuenta.
VITE_BRAND_DESCRIPTOR=Swimming Competition Platform
